// Regole del database di "Noi quattro". Si pubblicano da sole (workflow "Regole del database") a ogni modifica.
// Entra solo chi ha un documento in "membri" con la sua email come nome (li crea il programma "Prepara famiglia"):
// così nel codice pubblico non c'è nessuna email.
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function email() { return request.auth.token.email.lower(); }
    function membro() {
      return request.auth != null && exists(/databases/$(db)/documents/membri/$(email()));
    }
    function io() { return get(/databases/$(db)/documents/membri/$(email())).data.persona; }
    // Nomi dei documenti (v92, 08/11/2026): solo lettere, numeri e pochi segni, mai virgolette, spazi o < >.
    // Così un nome fatto apposta non può diventare codice nella pagina degli altri (revisione della v91).
    function idSicuro(id) { return id.matches('^[A-Za-z0-9_.:@+=-]{1,200}$'); }
    // L'ora di creazione dei documenti che scadono da soli: non nel futuro (al massimo un'ora avanti) e non vecchissima.
    function oraGiusta(ms) { return ms is int && ms > request.time.toMillis() - 86400000 && ms < request.time.toMillis() + 3600000; }
    // Chi è in scuola/<p>.copie vede la sezione di scuola di p così com'è: le sue note e i suoi voti, in sola lettura.
    function vedeCopia(p) { return io() in get(/databases/$(db)/documents/scuola/$(p)).data.get('copie', []); }
    // Chi è in scuola/<p>.prove vede le interrogazioni e le verifiche di p nel calendario comune (Sasha, 02/11/2026).
    function vedeProve(p) { return io() in get(/databases/$(db)/documents/scuola/$(p)).data.get('prove', []); }

    // Elenco della famiglia: ognuno legge solo il proprio, nessuno lo cambia dall'app.
    match /membri/{em} {
      allow read: if request.auth != null && email() == em;
      allow write: if false;
    }

    // Nome, colore e preferenze: tutti leggono, ognuno cambia solo i suoi.
    match /persone/{id} {
      allow read: if membro();
      allow update: if membro() && io() == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifiche', 'privacy', 'foto', 'fotoPath', 'strada'])
        && (!('strada' in request.resource.data) || request.resource.data.strada in [0, 10, 20, 30, 45]);
      allow create, delete: if false;
    }

    match /impegni/{id} {
      allow read: if membro();
      allow create: if membro() && idSicuro(id) && request.resource.data.creatoDa == io()
        && request.resource.data.fonte in ['app', 'import:' + io(), 'orario:' + io()];
      // Quelli dei calendari collegati li scrive solo il programma automatico.
      allow update: if membro() && ((resource.data.fonte in ['app', 'import:' + io(), 'orario:' + io()]
        && request.resource.data.fonte == resource.data.fonte
        && request.resource.data.creatoDa == resource.data.creatoDa)
        // Dei miei impegni dal calendario posso solo scegliere se gli altri vedono il titolo o "Occupato".
        || (resource.data.fonte == 'calendario:' + io()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t', 'n', 'nascosto']))
        // Come ci si va e "importante": li può segnare chiunque, su qualsiasi impegno.
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mezzo', 'imp']));
      allow delete: if membro() && resource.data.fonte in ['app', 'import:' + io(), 'orario:' + io()];
    }

    match /note/{id} {
      allow read: if membro();
      allow create: if membro() && idSicuro(id) && request.resource.data.by == io()
        && request.resource.data.keys().hasOnly(['by', 'x', 'creato']) && oraGiusta(request.resource.data.creato)
        && request.resource.data.x is string && request.resource.data.x.size() <= 300;
      // Chi l'ha scritta può cambiare il testo (Sasha, 03/11/2026).
      allow update: if membro() && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin'])
        || (resource.data.by == io() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x', 'modificato'])
            && request.resource.data.x is string && request.resource.data.x.size() > 0 && request.resource.data.x.size() <= 300)
        // Reazioni (v91, 08/11/2026): ognuno cambia solo la sua, tra quelle previste ('' = tolta).
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reazioni'])
            && request.resource.data.reazioni is map
            && request.resource.data.reazioni.diff(resource.data.get('reazioni', {})).affectedKeys().hasOnly([io()])
            && request.resource.data.reazioni.get(io(), '') in ['', '👍', '❤️', '😂', '😮', '🙏']));
      allow delete: if membro() && resource.data.by == io();
    }

    // Risposte alle note (v91): le scrive chiunque della famiglia, a nome suo, solo su una nota che c'è;
    // non si cambiano, le toglie chi le ha scritte (e il programma degli avvisi quando la nota sparisce).
    match /risposte/{id} {
      allow read: if membro();
      allow create: if membro() && idSicuro(id) && request.resource.data.keys().hasOnly(['nota', 'by', 'x', 'creato'])
        && request.resource.data.by == io() && request.resource.data.nota is string
        && exists(/databases/$(db)/documents/note/$(request.resource.data.nota))
        && request.resource.data.x is string && request.resource.data.x.size() > 0 && request.resource.data.x.size() <= 200
        && oraGiusta(request.resource.data.creato);
      allow update: if false;
      allow delete: if membro() && resource.data.by == io();
    }

    // Proposte (piccoli sondaggi): chi propone cambia tutto; gli altri aggiungono idee
    // (senza cambiare o togliere quelle che ci sono) e cambiano solo il proprio voto.
    match /proposte/{id} {
      allow read: if membro();
      allow create: if membro() && idSicuro(id) && request.resource.data.by == io()
        && request.resource.data.opzioni is map && request.resource.data.voti is map;
      allow update: if membro() && (resource.data.by == io() && request.resource.data.by == io()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opzioni', 'voti'])
            && request.resource.data.voti.diff(resource.data.voti).affectedKeys().hasOnly([io()])
            && request.resource.data.opzioni.diff(resource.data.opzioni).changedKeys().size() == 0
            && request.resource.data.opzioni.diff(resource.data.opzioni).removedKeys().size() == 0
            && request.resource.data.opzioni.size() <= 30
            // Una proposta decisa non si vota più, e le idee si aggiungono una alla volta.
            && resource.data.get('chiusa', false) != true
            && request.resource.data.opzioni.diff(resource.data.opzioni).addedKeys().size() <= 1));
      allow delete: if membro() && resource.data.by == io();
    }

    // Cose di tutta la famiglia (per ora: i nostri mezzi).
    match /famiglia/{doc} {
      allow read, write: if membro();
    }

    match /spesa/{id} {
      allow read, update, delete: if membro();
      allow create: if membro() && idSicuro(id);
    }

    // Ricette di famiglia: una pagina aperta, tutti scrivono e correggono; chi l'ha scritta resta segnato.
    match /ricette/{id} {
      function ok() { return request.resource.data.t is string && request.resource.data.t.size() <= 60
        && (!('ingr' in request.resource.data) || (request.resource.data.ingr is list && request.resource.data.ingr.size() <= 60)); }
      allow read, delete: if membro();
      allow create: if membro() && idSicuro(id) && request.resource.data.by == io() && ok();
      allow update: if membro() && request.resource.data.by == resource.data.by && ok();
    }

    // Sezione Personale, Scuola: l'orario lo scrive solo il programma "Orario scolastico"; tutti lo leggono (va nel calendario).
    match /scuola/{persona} {
      allow read: if membro();
      allow write: if false;
    }
    // Le note di scuola (interrogazioni, verifiche, compiti…): ognuno scrive e cambia solo le sue.
    match /compiti/{id} {
      function ok() { return request.resource.data.per == io() && request.resource.data.by == io()
        && request.resource.data.m is string && request.resource.data.m.size() <= 60
        && request.resource.data.d is string && request.resource.data.d.size() == 10
        && request.resource.data.tipo in ['interrogazione', 'verifica', 'compito', 'portare', 'altro']
        && request.resource.data.get('x', '') is string && request.resource.data.get('x', '').size() <= 200; }
      // Le legge chi le ha scritte e chi ha la copia della sua sezione di scuola (scuola/<persona>.copie, scelta di Sasha 02/11/2026).
      allow read: if membro() && (resource.data.per == io() || vedeCopia(resource.data.per)
        || (resource.data.tipo in ['interrogazione', 'verifica'] && vedeProve(resource.data.per)));
      allow create: if membro() && idSicuro(id) && ok();
      allow update: if membro() && resource.data.per == io() && ok();
      allow delete: if membro() && resource.data.per == io();
    }

    // I voti di scuola: come le note, ognuno legge e scrive solo i suoi.
    match /voti/{id} {
      function ok() { return request.resource.data.per == io() && request.resource.data.by == io()
        && request.resource.data.keys().hasOnly(['per', 'di', 'm', 'v', 'tipo', 'p', 'd', 'x', 'by', 'creato'])
        && request.resource.data.di is string && request.resource.data.di.size() <= 4
        && request.resource.data.m is string && request.resource.data.m.size() <= 60
        && request.resource.data.d is string && request.resource.data.d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.v is number && request.resource.data.v >= 0.75 && request.resource.data.v <= 10
        && request.resource.data.tipo in ['scritto', 'orale', 'pratico']
        && request.resource.data.get('p', 100) is number && request.resource.data.get('p', 100) >= 0 && request.resource.data.get('p', 100) <= 100
        && request.resource.data.get('x', '') is string && request.resource.data.get('x', '').size() <= 200; }
      allow read: if membro() && (resource.data.per == io() || vedeCopia(resource.data.per));
      allow create: if membro() && idSicuro(id) && ok();
      allow update: if membro() && resource.data.per == io() && ok();
      allow delete: if membro() && resource.data.per == io();
    }

    // Sezione "Per me" (02/11/2026): promemoria, appuntamenti fissi, scadenze, mostre segnate, liste e autori dei libri (05/11).
    // I libri degli autori li scrive il programma Libri con la chiave di servizio.
    // Le legge e le scrive solo chi le ha scritte (anche gli appuntamenti: nessun altro li vede). Il programma
    // delle notifiche le legge con la chiave di servizio per mandare gli avvisi.
    match /mie/{id} {
      function ok() { return request.resource.data.per == io()
        && request.resource.data.k in ['prom', 'appu', 'scad', 'lista', 'mostra', 'avvisi', 'autore']
        && request.resource.data.get('t', '') is string && request.resource.data.get('t', '').size() <= 80
        && request.resource.data.get('x', '') is string && request.resource.data.get('x', '').size() <= 300; }
      // p1 le legge anche degli altri, per controllare che la sezione funzioni (02/11/2026), ma mai gli appuntamenti fissi.
      allow read: if membro() && (resource.data.per == io() || (io() == 'p1' && resource.data.k in ['prom', 'scad', 'lista', 'mostra', 'autore']));
      allow create: if membro() && idSicuro(id) && ok();
      allow update: if membro() && resource.data.per == io() && ok();
      allow delete: if membro() && resource.data.per == io();
    }
    // Informazioni prese dal web dai programmi automatici (per ora le mostre di Firenze): tutti leggono, nessuno scrive.
    match /info/{doc} {
      allow read: if membro();
      allow write: if false;
    }

    // Una risposta per persona: ognuno scrive solo la sua (pranzo e cena, 04/11/2026).
    match /pranzo/{giorno} {
      allow read: if membro();
      allow create: if membro() && request.resource.data.keys().hasOnly([io()]);
      allow update: if membro() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([io()]);
    }
    match /cena/{giorno} {
      allow read: if membro();
      allow create: if membro() && request.resource.data.keys().hasOnly([io()]);
      allow update: if membro() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([io()]);
    }

    // Film (04/11/2026): il segno di ognuno su un film (da vedere, visto, non mi interessa, stelle). Ognuno scrive solo il suo.
    // Il segno è { s: '' | 'vedere' | 'visto' | 'no', v: stelle da 0 a 5 } (04/11/2026: niente valori strani).
    function segnoFilm(x) {
      return x is map && x.keys().hasAll(['s', 'v']) && x.keys().hasOnly(['s', 'v'])
        && x.s in ['', 'vedere', 'visto', 'no'] && x.v is number && x.v >= 0 && x.v <= 5;
    }
    match /film/{id} {
      allow read: if membro();
      allow create: if membro() && request.resource.data.keys().hasOnly([io()]) && segnoFilm(request.resource.data[io()]);
      allow update: if membro() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([io()])
        && segnoFilm(request.resource.data[io()]);
    }
    // Film e serie aggiunti a mano: tutti li vedono, solo chi li ha aggiunti li toglie.
    match /filmextra/{id} {
      allow read: if membro();
      allow create: if membro() && idSicuro(id) && request.resource.data.by == io()
        && request.resource.data.keys().hasOnly(['t', 'tipo', 'dove', 'by', 'creato'])
        && request.resource.data.t is string && request.resource.data.t.size() <= 90
        && request.resource.data.tipo in ['film', 'serie']
        && request.resource.data.dove is string && request.resource.data.dove.size() <= 20;
      allow delete: if membro() && resource.data.by == io();
    }

    // Liste dei regali: ognuno scrive solo la sua lista, tutti la leggono.
    match /regali/{id} {
      allow read: if membro();
      allow create: if membro() && idSicuro(id) && request.resource.data.per == io();
      allow update: if membro() && resource.data.per == io() && request.resource.data.per == io();
      allow delete: if membro() && resource.data.per == io();
    }

    // Le sorprese per una persona (chi prende cosa, idee segrete): tutti tranne lei.
    match /sorprese/{persona} {
      allow read, write: if membro() && io() != persona;
    }

    // La parte privata di ognuno: link del calendario, parole automatiche, scelte "mostra/occupato"
    // e i titoli veri dei suoi impegni nascosti. La vede e la cambia solo lui.
    // La legge e la scrive anche il programma automatico su GitHub, che ha la chiave di servizio.
    match /privati/{persona} {
      function campi() { return ['calendario', 'aggiornato', 'parole', 'scelte', 'dettagli']; }
      function link() { return request.resource.data.get('calendario', '') is string && request.resource.data.get('calendario', '').size() < 3000; }
      allow read, delete: if membro() && io() == persona;
      allow create: if membro() && io() == persona && request.resource.data.keys().hasOnly(campi()) && link();
      allow update: if membro() && io() == persona
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(campi()) && link();
    }

    // Viaggi: tutti li vedono e li completano; li cancella solo chi li ha creati.
    match /viaggi/{id} {
      allow read: if membro();
      allow create: if membro() && idSicuro(id) && request.resource.data.creatoDa == io();
      allow update: if membro() && request.resource.data.creatoDa == resource.data.creatoDa;
      allow delete: if membro() && resource.data.creatoDa == io();
    }

    // Foto dei viaggi: ognuno carica e toglie solo le sue; i cuori li mettono tutti.
    match /foto/{id} {
      allow read: if membro();
      allow create: if membro() && idSicuro(id) && request.resource.data.by == io();
      allow update: if membro() && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cuori'])
        // chi ha caricato un video può rifarne l'anteprima
        || (resource.data.by == io() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prev', 'pathP', 'prevOk'])));
      allow delete: if membro() && resource.data.by == io();
    }

    // Telefoni iscritti alle notifiche: ognuno iscrive solo sé stesso.
    match /token/{t} {
      allow create, update: if membro() && request.resource.data.persona == io();
      allow delete: if membro() && resource.data.persona == io();
      allow read: if false;
    }

    // Tutto il resto (es. "sistema", usato dai programmi automatici) è chiuso.
    match /{document=**} { allow read, write: if false; }
  }
}
