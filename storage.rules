// Regole dello spazio foto (Storage) di "Noi quattro". Si pubblicano da sole come firestore.rules.
// "persona" è dentro l'accesso di ognuno (la mette il programma Prepara famiglia): senza, niente foto.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function io() { return request.auth != null ? request.auth.token.get('persona', '') : ''; }

    // foto/<ricordo>/<nome> : le vedono solo i 4; ognuno carica e toglie solo le sue.
    match /foto/{viaggio}/{nome} {
      allow read: if io() != '';
      // Foto e video originali, fino a 2 GB l'uno.
      allow create: if io() != '' && request.resource.metadata.by == io()
        && request.resource.size < 2 * 1024 * 1024 * 1024 && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if io() != '' && resource.metadata.by == io();
    }

    // Foto profilo: ognuno la sua, piccola.
    match /profili/{persona}/{nome} {
      allow read: if io() != '';
      allow create: if io() == persona && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if io() == persona;
    }
    // Foto delle ricette: le vedono i 4, chi carica firma il file; la pagina è aperta, quindi tutti possono cambiarla.
    match /ricette/{ricetta}/{nome} {
      allow read: if io() != '';
      allow create: if io() != '' && request.resource.metadata.by == io()
        && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if io() != '';
    }
    match /{tutto=**} { allow read, write: if false; }
  }
}
